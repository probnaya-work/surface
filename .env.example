# Google Workspace SMTP credentials.
# Generate an App Password for your primary Workspace account:
#   Google Account → Security → 2-Step Verification → App passwords
# The primary account must have 2-Step Verification enabled.

# Primary Google Workspace login address (not the alias).
SMTP_USER=you@yourdomain.com

# 16-character App Password generated for that account.
SMTP_PASS=xxxx xxxx xxxx xxxx

# From address used when sending intake submissions.
# Must be the authenticated account or a verified alias on it.
SMTP_FROM=mail@probnaya.work
