# Google Workspace SMTP credentials.
# Generate an App Password for your primary Workspace account:
#   Google Account → Security → 2-Step Verification → App passwords
# The primary account must have 2-Step Verification enabled.

# Primary Google Workspace login address (not the alias).
SMTP_USER=you@yourdomain.com

# 16-character App Password generated for that account.
SMTP_PASS=xxxx xxxx xxxx xxxx

# From address used when sending intake submissions.
# Must be the authenticated account or a verified alias on it.
SMTP_FROM=mail@probnaya.work

# Machine Portrait V1 · hosted Stripe Checkout.
# Use matching test values together, or matching live values together.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_LIVEMODE=false

# Absolute public apparatus URL. Production must use HTTPS.
# Stripe returns to this URL after Checkout.
MPA_PUBLIC_URL=https://probnaya.work/instrument-mpa/
