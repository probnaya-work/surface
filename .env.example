# Required — Resend API key from resend.com/api-keys
RESEND_API_KEY=re_...

# Sender address. Must be from a domain verified in Resend.
# During initial testing before domain verification, use:
#   RESEND_FROM=onboarding@resend.dev
# For production after domain verification, use:
#   RESEND_FROM=PROBNAYA Intake <intake@probnaya.work>
RESEND_FROM=PROBNAYA Intake <intake@probnaya.work>
