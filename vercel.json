{
  "cleanUrls": true,
  "redirects": [
    { "source": "/index",      "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/access(/.*)?", "destination": "https://access.probnaya.work/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/heard", "destination": "/heard/index.html" },
    { "source": "/heard/protocol", "destination": "/heard/protocol/index.html" }
  ],
  "headers": [
    {
      "source": "/interior(/.*)?",
      "headers": [
        { "key": "Cache-Control",   "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag",    "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
