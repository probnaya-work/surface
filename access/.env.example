# Local development only. Production uses compiled, exact RP/origin constants.
# Production requires ACCESS_ENV=production, DATABASE_URL with sslmode=verify-full,
# and three distinct keys from `openssl rand -base64 32`. On Vercel it runs only
# in the Production environment.
ACCESS_ENV=development
ACCESS_LOCAL_ORIGIN=http://localhost:4174
# The locally served public site (Interior and recognition). Omit to keep the relation read closed.
ACCESS_PUBLIC_ORIGIN=http://localhost:4173
DATABASE_URL=postgres://access:replace-me@127.0.0.1:5432/probnaya_access
SESSION_HASH_KEY=
RECOVERY_HASH_KEY=
NETWORK_HASH_KEY=

# Optional local-only in-memory store. Never accepted when ACCESS_ENV=production.
ACCESS_USE_MEMORY_STORE=true
# Local establishment: open http://localhost:4174/#establish=<this token>.
ACCESS_DEV_ENROLLMENT_TOKEN=LOCAL-DEVELOPMENT-ENROLLMENT-TOKEN-0001
ACCESS_DEV_PUBLIC_ID=PROB–H–LOCAL
# Local REQUEST ACCESS: print request messages instead of sending them. Never accepted in production.
ACCESS_DEV_REQUEST_OUTBOX=console

# Production request mail (Vercel Production environment only). A dedicated
# sender account, never mail@probnaya.work itself; IMAP/POP disabled for it.
# ACCESS_REQUEST_SMTP_USER=access-requests@probnaya.work
# ACCESS_REQUEST_SMTP_PASS=
# ACCESS_REQUEST_SMTP_FROM=access-requests@probnaya.work
